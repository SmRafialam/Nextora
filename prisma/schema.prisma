// Nestora database schema (PostgreSQL).
// Money is always an integer number of paisa (1 taka = 100 paisa). Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Catalog ────────────────────────────────────────────────────────────────

model Category {
  slug        String    @id
  name        String
  sub         String    // short line under the tile, e.g. "Sofas, armchairs, coffee tables"
  headline    String    // listing h1, first part
  headlineEm  String    // listing h1, italic part
  intro       String
  // Presentation of the homepage tile (from the approved design)
  artKind     String
  artFill     String
  bg          String
  span        String?   // "big" | "wide"
  artInset    String
  labelSize   String
  position    Int       @default(0)
  products    Product[]
}

model Product {
  id          String   @id // short stable key, e.g. "halden" (also used by guest carts)
  slug        String   @unique
  name        String
  meta        String
  type        String
  description String
  dimensions  String
  material    String
  artKind     String
  bg          String
  bgAlt       String
  badge       String?  // "Bestseller" | "New" | "Sale"
  isNew       Boolean  @default(false)
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  categorySlug String
  category    Category @relation(fields: [categorySlug], references: [slug])
  variants    Variant[]
  collections CollectionProduct[]
  wishlistedBy WishlistItem[]
  reviews     Review[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categorySlug, isActive])
}

model Variant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String  @unique
  position       Int     // colour index used by carts (0 = default colour)
  colorName      String
  colorHex       String
  pricePaisa     Int
  compareAtPaisa Int?
  stock          Int     @default(0)
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@unique([productId, position])
}

model Collection {
  slug     String @id
  title    String
  titleEm  String
  intro    String
  artKind  String
  artFill  String
  bg       String
  position Int    @default(0)
  products CollectionProduct[]
}

model CollectionProduct {
  collectionSlug String
  productId      String
  position       Int        @default(0)
  collection     Collection @relation(fields: [collectionSlug], references: [slug], onDelete: Cascade)
  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionSlug, productId])
}

// ─── Customers (Auth.js models are added in Phase 5) ───────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  passwordHash  String?
  emailVerified DateTime?
  role          Role      @default(CUSTOMER)
  sessionVersion Int      @default(0) // bumped on password reset to sign out other sessions
  marketingOptIn Boolean  @default(false)
  smsUpdates     Boolean  @default(true)
  restockAlerts  Boolean  @default(false)
  tokens        AuthToken[]
  addresses     Address[]
  cart          Cart?
  wishlist      WishlistItem[]
  orders        Order[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  name      String
  phone     String
  line      String
  area      String
  district  String
  isDefault Boolean @default(false)

  @@index([userId])
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// One-time tokens for email verification and password reset. Only a SHA-256 hash is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// ─── Cart and wishlist ─────────────────────────────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique // random token in an httpOnly cookie for guests
  couponCode String?
  items      CartItem[]
  updatedAt  DateTime   @updatedAt
  createdAt  DateTime   @default(now())
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([cartId, variantId])
}

model WishlistItem {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

// ─── Coupons ───────────────────────────────────────────────────────────────

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  code             String     @id // stored upper-case
  type             CouponType
  value            Int        // percent (1–100) or paisa
  label            String
  minSubtotalPaisa Int        @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  usedCount        Int        @default(0)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
}

// ─── Orders and payments ───────────────────────────────────────────────────

enum OrderStatus {
  PENDING      // created, awaiting payment confirmation (online methods)
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  SSLCOMMERZ
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id             String        @id @default(cuid())
  number         String        @unique // customer-facing, e.g. NS-482190
  idempotencyKey String        @unique // from the checkout form; stops duplicate orders
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  email          String
  phone          String
  name           String
  addressLine    String
  area           String
  district       String
  note           String?
  shipMethod     String
  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(UNPAID)
  couponCode     String?
  subtotalPaisa  Int
  discountPaisa  Int           @default(0)
  shippingPaisa  Int
  totalPaisa     Int
  items          OrderItem[]
  payments       Payment[]
  events         OrderEvent[]
  refunds        Refund[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        Variant @relation(fields: [variantId], references: [id])
  // Snapshot at purchase time, so later catalog edits never change past orders
  productName    String
  colorName      String
  unitPricePaisa Int
  quantity       Int
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    PaymentMethod
  status      PaymentStatus
  amountPaisa Int
  providerRef String?       @unique // provider transaction id, verified server-side
  raw         Json?         // provider response, secrets stripped
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actor     String?     // user id, "system" or "webhook:<provider>"
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Refund {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountPaisa Int
  reason      String
  providerRef String?
  createdBy   String
  createdAt   DateTime @default(now())
}

// ─── Reviews, newsletter, audit ────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int          // 1–5
  title            String
  body             String
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  createdAt        DateTime     @default(now())

  @@unique([productId, userId])
  @@index([productId, status])
}

model NewsletterSubscriber {
  email        String    @id
  confirmedAt  DateTime?
  unsubscribed Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String   // e.g. "order.status", "product.update", "refund.create"
  target    String
  data      Json?
  createdAt DateTime @default(now())

  @@index([target, createdAt])
}
