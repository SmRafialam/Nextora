# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL="postgresql://nestora:change-me@127.0.0.1:5432/nestora?schema=public"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth.js: generate with `npx auth secret` or any 32+ byte random string
AUTH_SECRET=change-me

# Email (optional). Without these, verification and reset links are only printed to the
# dev server console in development, and email features are disabled in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nestora <hello@example.com>"
